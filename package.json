{
  "name": "acp-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev -p 5173 -H 127.0.0.1",
    "build": "vinext build",
    "start": "vinext start",
    "preview": "vinext start",
    "mock": "node mock/server.mjs",
    "dev:all": "npm run dev",
    "dev:worker": "npm run build && wrangler dev --config wrangler.admin.toml",
    "deploy": "vinext deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "vinext lint",
    "docs": "npm --prefix website start",
    "docs:gen-api": "npm --prefix website run gen-api-docs",
    "docs:write-translations": "npm --prefix website run write-translations -- --locale pt",
    "docs:build": "npm --prefix website run build",
    "docs:serve": "npm --prefix website run serve",
    "docs:merge": "rm -rf dist/client/docs && mkdir -p dist/client && cp -R website/build dist/client/docs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.30",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "json-server": "^0.17.4",
    "next": "^16.2.1",
    "oxlint": "^1.71.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vinext": "^0.0.49",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
