# Client: leave unset to call same-origin `/api` (vinext App Router + Worker).
# Point at standalone json-server when using `make mock`.
# VITE_API_URL=http://localhost:4001

# Server/Worker: when set, `/api/*` proxies to this base URL (clouapp-style catch-all).
# When unset or empty, the in-worker mock API is used.
# Local (vinext): export in your shell or a gitignored `.env`.
# Cloudflare: `wrangler secret put API_PROXY_TARGET` (or [vars] in wrangler for non-secrets).
# API_PROXY_TARGET=https://api.example.com
